<Project>
  <!--
    Self-contained, single-file linux-x64 publish profile. Only consulted by an explicit
    `dotnet publish WitcherScriptMerger.Headless/WitcherScriptMerger.Headless.csproj -p:PublishProfile=linux-x64`
    (or Visual Studio's Publish UI) - a plain `dotnet build`/`dotnet publish` with no
    profile selected never reads this file, so ordinary builds are unaffected. This
    cross-compiles fine from Windows - producing the binary doesn't require a Linux
    machine, only *running* it does. See CLAUDE.md's "Publishing" section.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
